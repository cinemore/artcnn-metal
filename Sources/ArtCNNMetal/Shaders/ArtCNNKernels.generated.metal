// 只保留正式运行使用的算子；许可见SpatialEnhancementLicenses.txt。
#include <metal_stdlib>
using namespace metal;

float4 artRead(texture2d_array<float, access::read> input, int2 p, uint group) {
    // Keras / ONNX SAME_UPPER 为零填充，不依赖越界 texelFetch 的未定义行为。
    if (p.x < 0 || p.y < 0 || p.x >= int(input.get_width()) || p.y >= int(input.get_height())) return 0;
    return input.read(uint2(p), group);
}

kernel void artLuma(texture2d<float, access::read> input [[texture(0)]],
                    texture2d_array<float, access::write> output [[texture(1)]],
                    constant float4& coefficients [[buffer(0)]], uint2 p [[thread_position_in_grid]]) {
    if (p.x >= input.get_width() || p.y >= input.get_height()) return;
    float3 rgb = input.read(p).rgb;
    float y = rgb.r * coefficients.r + rgb.g * coefficients.g + rgb.b * coefficients.b;
    output.write(float4(y, 0, 0, 0), p, 0);
}




// 保留原shuffle的子像素选择与亮度裁剪，直接进行颜色重建，省去2×亮度中间纹理。
kernel void artShuffleColor(texture2d<float, access::sample> input [[texture(0)]],
                            texture2d_array<float, access::read> features [[texture(1)]],
                            texture2d<float, access::write> output [[texture(2)]],
                            constant float4& coefficients [[buffer(0)]],
                            constant uint& outputOriginX [[buffer(1)]], uint2 position [[thread_position_in_grid]]) {
    uint2 p = position + uint2(outputOriginX, 0);
    if (p.x >= output.get_width() || p.y >= output.get_height()) return;
    float4 values = features.read(p / 2, 0);
    float y = clamp(values[(p.y % 2) * 2 + p.x % 2], 0.0f, 1.0f);
    constexpr sampler sample(coord::normalized, address::clamp_to_edge, filter::linear);
    float2 uv = (float2(p) + 0.5f) / float2(output.get_width(), output.get_height());
    float3 rgb = input.sample(sample, uv).rgb;
    float oldY = rgb.r * coefficients.r + rgb.g * coefficients.g + rgb.b * coefficients.b;
    output.write(float4(clamp(rgb + (y - oldY), 0.0f, 1.0f), 1), p);
}

